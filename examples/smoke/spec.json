    "division": "Pipeline verification",
    "title": "SMOKE TEST RIG",
    "subtitle": "Exercises parenting, instancing, details and every channel type",
    "archetype": "rotating-machine",
    "units": "mm",
    "projection": "FIRST ANGLE",
    "tolerance": "±0.5",
    "titleBlock": {
      "drawingNo": "B2D-0001", "sheet": "1 OF 1", "scale": "1 : 5", "rev": "A",

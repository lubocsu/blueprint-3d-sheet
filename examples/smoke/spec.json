      "sub": "cut on the shaft centreline", "section": { "plane": "xy", "at": 0 } }
  ],

  "motions": [
    { "id": "run",   "label": "RUN",   "set": { "rpm": 420 } },
    { "id": "fast",  "label": "FAST",  "set": { "rpm": 900 } },
    { "id": "open",  "label": "OPEN",  "set": { "open": 1 } },
    { "id": "strike","label": "STRIKE","set": { "burst": 1 }, "momentary": true },
    { "id": "guard", "label": "GUARD", "set": { "guard": 0 } },
    { "id": "apart", "label": "EXPLODE", "set": { "apart": 1 } }
  ],

  "instruments": [
    { "label": "SHAFT SPEED",   "expr": "rpm",                "format": "%.0f rpm" },
    { "label": "TIP VELOCITY",  "expr": "rpm * 0.0110",       "format": "%.1f m/s" },
    { "label": "DOOR ANGLE",    "expr": "open * 95",          "format": "%.1f°" },
    { "label": "GUARD",         "expr": "guard * 100",        "format": "%.0f %" },
    { "label": "SEPARATION",    "expr": "apart * 320",        "format": "%.0f mm" },
    { "label": "REFRESH",       "expr": "fps",                "format": "%.0f fps" }
  ]

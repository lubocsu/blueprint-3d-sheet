  "annotations": {
    "callouts": [
      { "n": 1, "text": "Main shaft, 100 mm ground", "anchor": "shaft" },
      { "n": 2, "text": "Flywheel, 46 kg", "anchor": "flywheel" },
      { "n": 3, "text": "Impeller vane, 8 off", "anchor": "vane" },
      { "n": 4, "text": "Bearing housing, split", "anchor": "housing" },
      { "n": 5, "text": "Anti-vibration mount", "anchor": "mount" },
      { "n": 6, "text": "Sight glass, level datum", "anchor": "sight" },
      { "n": 7, "text": "Mesh guard, interlocked", "anchor": "guard" },
      { "n": 8, "text": "Exhaust stack, Ø90", "anchor": "stack" }
    ],
    "dimensions": [
      { "label": "900", "from": [-450, 0, 260], "to": [450, 0, 260], "offset": [0, -70, 60] },
      { "label": "620", "from": [-450, 0, -260], "to": [-450, 620, -260], "offset": [-90, 0, 0] },

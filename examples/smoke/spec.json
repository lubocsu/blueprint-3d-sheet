  "views": [
    { "id": "iso",   "label": "ISO",   "az": 38,  "el": 22 },
    { "id": "q34",   "label": "3/4 R", "az": 145, "el": 20 },
    { "id": "side",  "label": "SIDE",  "az": 90, "el": 0, "projection": "orthographic",
      "caption": "SIDE ELEVATION", "sub": "Scale 1:5 · datum condition" },
    { "id": "front", "label": "FRONT", "az": 0,  "el": 0, "projection": "orthographic",
      "caption": "FRONT ELEVATION", "sub": "viewed on arrow F" },
    { "id": "plan",  "label": "PLAN",  "az": 0,  "el": 89, "projection": "orthographic",
      "caption": "PLAN VIEW", "sub": "on the bed datum" },
